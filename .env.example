# ============================================================================
# FASTAPI BACKEND CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
ENVIRONMENT=development

# CORS Configuration (Origines autorisées pour les requêtes frontend)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Base de données SQLite
DATABASE_PATH=./prompts.db

# Système de Journalisation (Logging)
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============================================================================
# STREAMLIT FRONTEND CONFIGURATION
# ============================================================================
API_BASE_URL=http://localhost:8000

# ============================================================================
# FOURNISSEURS D'IA & MODÈLES LLM
# ============================================================================
# Fournisseur par défaut : 'mock', 'gemini', 'openai', 'groq', 'ollama'
# En mode 'mock', le générateur fonctionne sans clé API pour démonstration & tests.
DEFAULT_AI_PROVIDER=mock

# 1. Google Gemini (Recommandé - Clé gratuite sur https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI (Optionnel - https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Groq Cloud (Optionnel - Gratuit et ultra-rapide sur https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Ollama (Optionnel - Modèles locaux gratuits)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
